/* DESCENTE — le wiki se défait, la VHS prend la place */
.d12 #texte,.d10 #modifier,.d10 #historique,.d10 .tabs a:not(.selected){display:none}
.d10 .infobox{display:none}
.d15 .sidebar,.d15 .contents,.d15 #discussion{display:none}
.d15 .layout{display:block}
.d20{--vhs:#2b1893;background:var(--vhs)!important;color:#fff!important;font-family:'VT323','Courier New',monospace!important;text-transform:uppercase;letter-spacing:.14em;font-size:24px;line-height:1.25;overflow-x:hidden}
.d20 .site-header,.d20 .sidebar,.d20 .tabs,.d20 .breadcrumb,.d20 .metadata,.d20 #references,.d20 .discovery>span,.d20 .discovery>h2,.d20 .discovery>p,.d20 footer,.d20 #discussion{display:none!important}
.d20 .article{background:transparent!important;color:#fff!important;max-width:640px;margin:0 auto!important;padding:14vh 22px 24vh!important;border:0!important;text-shadow:2px 0 rgba(255,40,80,.55),-2px 0 rgba(0,200,255,.55),0 0 6px rgba(255,255,255,.5)}
.d20 .article h1{font-size:30px;text-align:center;font-weight:400;border:0;margin:0 0 .9em;color:#fff!important}
.d20 .article h2{font-size:24px;font-weight:400;border:0;color:#fff!important}
.d20 .article p{margin:0 0 1em;color:#fff}
.d20 .discovery{border:0!important;background:none!important;padding:0!important}
.d20 .navigation-links a{color:#fff!important;text-decoration:none;animation:blink 1.4s steps(2) infinite}
.d36 .navigation-links a:first-child:not(:only-child){display:none}
.d30 .article{filter:blur(.35px) saturate(1.2)}
#snow{position:fixed;inset:0;width:100%;height:100%;z-index:9999;pointer-events:none;image-rendering:pixelated;mix-blend-mode:screen}
#roll{position:fixed;left:0;right:0;height:18vh;top:-20vh;z-index:9998;pointer-events:none;background:linear-gradient(transparent,rgba(255,255,255,.07),transparent);animation:roll 7s linear infinite}
#osd,#bar{position:fixed;z-index:10000;left:0;right:0;pointer-events:none;font-family:'VT323','Courier New',monospace;text-transform:uppercase;letter-spacing:.14em;color:#fff;text-shadow:2px 0 rgba(255,40,80,.6),-2px 0 rgba(0,200,255,.6)}
#osd{top:14px;padding:0 20px;display:flex;justify-content:space-between;font-size:26px;color:#9dffb0}
#bar{bottom:0;padding:0 16px 10px;font-size:22px;border-top:0}
#bar::before{content:"";display:block;height:2px;background:#fff;margin-bottom:6px;opacity:.85}
#bar div{display:flex;justify-content:space-between}
@keyframes roll{to{top:110vh}}
@keyframes blink{50%{opacity:.15}}
.d41 #roll{animation-duration:3s}
.d50{--vhs:#000;font-size:22px}
.d50 *{animation:none!important;filter:none!important}
.d50 .article{text-shadow:none}
.d50 #snow,.d50 #roll,.d50 #osd,.d50 #bar{display:none}
@media (prefers-reduced-motion:reduce){#roll,.navigation-links a{animation:none!important}}
